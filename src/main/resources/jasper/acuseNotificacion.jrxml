$P{casaDeJusticia},
$P{fechaGeneracionDocumento},
("F".equals($P{sexo}) ? "la suscrita diligenciaria adscrita" : "el suscrito diligenciario adscrito"),
$P{nombreSala},
$P{para},
$P{tipoParte},
$P{nombreDestinatario}
)]]></textFieldExpression>
			</textField>
		</band>
		<band height="316">
			<printWhenExpression><![CDATA[!("Cuarta Sala Colegiada en Materia Penal".equals($P{nombreSalaDestino}))]]></printWhenExpression>
			<textField>
				<reportElement stretchType="ElementGroupHeight" x="0" y="26" width="425" height="290" uuid="6c388faf-48af-4640-9dc1-2a87d556773c">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" markup="html">
					<font size="11"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0"/>
				</textElement>
				<textFieldExpression><![CDATA[String.format(
"En %s, a las <b>%s</b>, %s en los Órganos del Sistema Acusatorio Adversarial que Conforman la %s en Materia Penal del Tribunal Superior de Justicia del Poder Judicial del Estado de Puebla, hago constar que a través del \"<b>Sistema Electronico De Control y Gestión Judicial</b>\" se tiene certeza de que fue recibido el correo electrónico enviado a la dirección %s, señalado para notificar al <b>%s %s</b>, surtiendo así los efectos de la notificación, al dar a conocer al interesado por correo electrónico el auto emitido, constando fecha, hora y correo que visualiza el mensaje en comento. Lo anterior con fundamento en los artículos 14 y 16 de la Constitución Política de los Estados Unidos Mexicanos, 82, 83, 84 y 85 del Código Nacional de Procedimientos Penales y 30 QUATER fracción II de la Ley Orgánica del Poder Judicial del Estado de Puebla. <b>Conste. Doy Fe.</b> - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -