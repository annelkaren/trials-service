	<detail>
		<band height="316" splitType="Stretch">
			<printWhenExpression><![CDATA[("Cuarta Sala Colegiada en Materia Penal".equals($P{nombreSalaDestino}))]]></printWhenExpression>
			<textField>
				<reportElement stretchType="ElementGroupHeight" x="0" y="26" width="425" height="290" uuid="b3899300-09dd-4637-80e6-1b82a1202930">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" markup="html">
					<font size="11"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0"/>
				</textElement>
				<textFieldExpression><![CDATA[String.format(
"En %s, a las <b>%s</b>, %s  a la %s, del Tribunal Superior de Justicia del Poder Judicial del Estado de Puebla, hago constar que a través del \"<b>Sistema Electronico De Control y Gestión Judicial</b>\" se tiene certeza de que fue recibido el correo electrónico enviado a la dirección %s, señalado para notificar al <b>%s %s</b>, surtiendo así los efectos de la notificación, al dar a conocer al interesado por correo electrónico el auto emitido, constando fecha, hora y correo que visualiza el mensaje en comento. Lo anterior con fundamento en los artículos 14 y 16 de la Constitución Política de los Estados Unidos Mexicanos y 30 QUATER fracción II de la Ley Orgánica del Poder Judicial del Estado de Puebla. <b>Conste. Doy Fe.</b> - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -