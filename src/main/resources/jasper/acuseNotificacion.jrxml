$P{casaDeJusticia},
$P{fechaGeneracionDocumento},
("F".equals($P{sexo}) ? "la suscrita Notificadora" : "el suscrito Notificador"),
$P{nombreSalaShortName},
$P{para},
$P{tipoParte},
$P{nombreDestinatario}
)]]></textFieldExpression>
			</textField>
		</band>
	</detail>
