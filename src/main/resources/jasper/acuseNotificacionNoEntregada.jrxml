				<textElement textAlignment="Justified" markup="html">
					<font size="12"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0"/>
				</textElement>
				<textFieldExpression><![CDATA[String.format(
"En %s, %s en los Órganos del Sistema Acusatorio Adversarial que conforman la %s del Tribunal Superior de Justicia del Poder Judicial del Estado de Puebla, hago constar que a las <b> %s</b>, recibo notificación de estatus de entrega del  \"Sistema Electronico De Control y Gestión Judicial \" que dice: <b>%s</b>; lo que se hace constar para los efectos legales a que haya lugar; con fundamento en los artículos 14 y 16 de la Constitución Política de los Estados Unidos Mexicanos, 82, 83, 84 y 85 del Código Nacional de Procedimientos Penales y 30 QUATER fracción II de la Ley Orgánica del Poder Judicial del Estado de Puebla. <b>Conste. Doy FE.</b> - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -",
$P{casaDeJusticia},
("F".equals($P{sexo}) ? "la suscrita Notificadora" : "el suscrito Notificador"),
$P{nombreSala},
$P{fechaIntentoEnvioTexto},
$P{razonNoEntregaTecnica}
)]]></textFieldExpression>
			</textField>
